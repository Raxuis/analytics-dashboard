# Upstash Redis REST endpoint and server-only token. Never prefix with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Legacy names are also supported: REDIS_URL and REDIS_KEY.
# Without a complete configuration the site works and analytics reports unavailable.

# Migration from the original deployment:
# REDIS_KEY alone still targets its historical eu2-handy-ghoul-31376.upstash.io database.
# Prefer adding REDIS_URL explicitly, or migrate both values to the standard pair above.
# A standard UPSTASH_REDIS_REST_TOKEN without a URL never uses that legacy endpoint.
# Explicit configured URLs always win and must use HTTPS.

# Vercel Marketplace injects KV_REST_API_URL and KV_REST_API_TOKEN automatically.
# These REST credentials take precedence over legacy REDIS_URL and REDIS_KEY.
# The Marketplace REDIS_URL uses rediss:// and is not the HTTPS REST endpoint.
